{
  "openapi": "3.1.0",
  "info": {
    "title": "OperiX Public API",
    "version": "1.0.0",
    "description": "Versioned, tenant-scoped APIs for OperiX Invoice and OperiX Booking. Amounts and scheduling decisions are calculated by the same domain services used by the OperiX applications.",
    "contact": { "url": "https://helpcenter.operixsuite.com/en/api/" }
  },
  "servers": [{ "url": "https://api.operixsuite.com", "description": "Live and test credentials use the same versioned host" }],
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "Invoice customers" }, { "name": "Invoice products" }, { "name": "Invoice documents" }, { "name": "Invoice payments" },
    { "name": "Booking services" }, { "name": "Booking availability" }, { "name": "Booking resources" }, { "name": "Bookings" }
  ],
  "paths": {
    "/v1/invoice/customers": {
      "get": { "tags": ["Invoice customers"], "summary": "List customers", "x-operix-scope": "customer:read", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/ExternalReference" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } },
      "post": { "tags": ["Invoice customers"], "summary": "Create a customer", "x-operix-scope": "customer:write", "x-operix-idempotent": true, "requestBody": { "$ref": "#/components/requestBodies/Customer" }, "responses": { "201": { "$ref": "#/components/responses/Customer" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/invoice/customers/{id}": {
      "get": { "tags": ["Invoice customers"], "summary": "Get a customer", "x-operix-scope": "customer:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Customer" }, "404": { "$ref": "#/components/responses/Error" } } },
      "patch": { "tags": ["Invoice customers"], "summary": "Update a customer", "x-operix-scope": "customer:write", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "$ref": "#/components/requestBodies/Customer" }, "responses": { "200": { "$ref": "#/components/responses/Customer" } } }
    },
    "/v1/invoice/products": {
      "get": { "tags": ["Invoice products"], "summary": "List products", "x-operix-scope": "product:read", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/ExternalReference" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } },
      "post": { "tags": ["Invoice products"], "summary": "Create a product", "x-operix-scope": "product:write", "x-operix-idempotent": true, "requestBody": { "$ref": "#/components/requestBodies/Product" }, "responses": { "201": { "$ref": "#/components/responses/Product" } } }
    },
    "/v1/invoice/products/{id}": {
      "get": { "tags": ["Invoice products"], "summary": "Get a product", "x-operix-scope": "product:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Product" } } },
      "patch": { "tags": ["Invoice products"], "summary": "Update a product", "x-operix-scope": "product:write", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "$ref": "#/components/requestBodies/Product" }, "responses": { "200": { "$ref": "#/components/responses/Product" } } }
    },
    "/v1/invoice/invoices": {
      "get": { "tags": ["Invoice documents"], "summary": "List invoices and supported commercial documents", "description": "Use document_type to filter invoices, offers, pro-formas, orders, delivery notes, credit notes, and debit notes where the tenant lifecycle supports them.", "x-operix-scope": "invoice:read", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Status" }, { "$ref": "#/components/parameters/DocumentType" }, { "$ref": "#/components/parameters/ExternalReference" }, { "$ref": "#/components/parameters/CustomerId" }, { "$ref": "#/components/parameters/CreatedAfter" }, { "$ref": "#/components/parameters/CreatedBefore" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } },
      "post": { "tags": ["Invoice documents"], "summary": "Create an invoice or supported commercial document", "description": "Totals, VAT, discounts, fees, numbering, inventory effects, and lifecycle status are calculated by OperiX. Client-supplied totals are ignored.", "x-operix-scope": "invoice:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Invoice" }, "responses": { "201": { "$ref": "#/components/responses/Invoice" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/invoice/invoices/{id}": {
      "get": { "tags": ["Invoice documents"], "summary": "Get an invoice", "x-operix-scope": "invoice:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Invoice" } } },
      "patch": { "tags": ["Invoice documents"], "summary": "Update a draft invoice", "description": "Finalized financial records cannot be rewritten. Use the supported correction documents for legal changes.", "x-operix-scope": "invoice:write", "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Invoice" }, "responses": { "200": { "$ref": "#/components/responses/Invoice" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/invoice/invoices/{id}/finalize": { "post": { "tags": ["Invoice documents"], "summary": "Finalize an invoice", "x-operix-scope": "invoice:finalize", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Invoice" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/invoice/invoices/{id}/void": { "post": { "tags": ["Invoice documents"], "summary": "Void an invoice", "description": "OperiX validates whether the current document status is legally and technically voidable.", "x-operix-scope": "invoice:void", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reason" }, "responses": { "200": { "$ref": "#/components/responses/Invoice" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/invoice/invoices/{id}/pdf": { "get": { "tags": ["Invoice documents"], "summary": "Retrieve an invoice PDF", "description": "Returns a short-lived signed PDF handoff. The PDF uses the same OperiX Invoice template as the native application.", "x-operix-scope": "document:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "302": { "description": "Short-lived PDF URL" }, "200": { "description": "Authenticated PDF stream", "content": { "application/pdf": { "schema": { "type": "string", "format": "binary" } } } } } } },
    "/v1/invoice/payments": {
      "get": { "tags": ["Invoice payments"], "summary": "List payments", "description": "Returns tenant-scoped payments, capped at 100 records per cursor page. Filter by customer_id, invoice_id, external_reference, or creation bounds when needed.", "x-operix-scope": "payment:read", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/CustomerId" }, { "name": "invoice_id", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/ExternalReference" }, { "$ref": "#/components/parameters/CreatedAfter" }, { "$ref": "#/components/parameters/CreatedBefore" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } },
      "post": { "tags": ["Invoice payments"], "summary": "Record a payment", "description": "Payment allocation, balances, currencies, and immutable financial rules are enforced by the Invoice domain.", "x-operix-scope": "payment:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Payment" }, "responses": { "201": { "$ref": "#/components/responses/Payment" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/invoice/invoices/{id}/payments": { "get": { "tags": ["Invoice payments"], "summary": "List payments allocated to an invoice", "description": "The response is capped at 100 records and is tenant-scoped.", "x-operix-scope": "payment:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } } },
    "/v1/booking/customers": {
      "get": { "tags": ["Bookings"], "summary": "List booking customers", "x-operix-scope": "booking_customer:read", "parameters": [{ "$ref": "#/components/parameters/Search" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } },
      "post": { "tags": ["Bookings"], "summary": "Create or resolve a booking customer", "x-operix-scope": "booking_customer:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Customer" }, "responses": { "200": { "$ref": "#/components/responses/Customer" }, "201": { "$ref": "#/components/responses/Customer" } } }
    },
    "/v1/booking/services": {
      "get": { "tags": ["Booking services"], "summary": "List services", "x-operix-scope": "service:read", "parameters": [{ "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } },
      "post": { "tags": ["Booking services"], "summary": "Create a service", "x-operix-scope": "service:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Service" }, "responses": { "201": { "$ref": "#/components/responses/Service" } } }
    },
    "/v1/booking/services/{id}": { "get": { "tags": ["Booking services"], "summary": "Get a service", "x-operix-scope": "service:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Service" } } }, "patch": { "tags": ["Booking services"], "summary": "Update a service", "x-operix-scope": "service:write", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "$ref": "#/components/requestBodies/Service" }, "responses": { "200": { "$ref": "#/components/responses/Service" } } } },
    "/v1/booking/providers": { "get": { "tags": ["Booking resources"], "summary": "List booking providers", "x-operix-scope": "provider:read", "parameters": [{ "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } }, "post": { "tags": ["Booking resources"], "summary": "Create a booking provider", "x-operix-scope": "provider:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Provider" }, "responses": { "201": { "$ref": "#/components/responses/Provider" } } } },
    "/v1/booking/providers/{id}": { "get": { "tags": ["Booking resources"], "summary": "Get a booking provider", "x-operix-scope": "provider:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Provider" } } }, "patch": { "tags": ["Booking resources"], "summary": "Update a booking provider", "x-operix-scope": "provider:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Provider" }, "responses": { "200": { "$ref": "#/components/responses/Provider" } } } },
    "/v1/booking/locations": { "get": { "tags": ["Booking resources"], "summary": "List locations", "x-operix-scope": "location:read", "parameters": [{ "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } }, "post": { "tags": ["Booking resources"], "summary": "Create a location", "x-operix-scope": "location:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Location" }, "responses": { "201": { "$ref": "#/components/responses/Location" } } } },
    "/v1/booking/locations/{id}": { "get": { "tags": ["Booking resources"], "summary": "Get a location", "x-operix-scope": "location:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Location" } } }, "patch": { "tags": ["Booking resources"], "summary": "Update a location", "x-operix-scope": "location:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Location" }, "responses": { "200": { "$ref": "#/components/responses/Location" } } } },
    "/v1/booking/resources": { "get": { "tags": ["Booking resources"], "summary": "List resources", "x-operix-scope": "resource:read", "parameters": [{ "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } }, "post": { "tags": ["Booking resources"], "summary": "Create a resource", "x-operix-scope": "resource:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Resource" }, "responses": { "201": { "$ref": "#/components/responses/Resource" } } } },
    "/v1/booking/resources/{id}": { "get": { "tags": ["Booking resources"], "summary": "Get a resource", "x-operix-scope": "resource:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Resource" } } }, "patch": { "tags": ["Booking resources"], "summary": "Update a resource", "x-operix-scope": "resource:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Resource" }, "responses": { "200": { "$ref": "#/components/responses/Resource" } } } },
    "/v1/booking/availability": { "get": { "tags": ["Booking availability"], "summary": "Check availability", "description": "Delegates to the canonical Booking availability engine. Availability is checked again during booking creation.", "x-operix-scope": "availability:read", "parameters": [{ "name": "service_id", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "date", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }, { "name": "provider_id", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "name": "location_id", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "name": "resource_id", "in": "query", "schema": { "type": "string", "format": "uuid" } }, { "name": "participant_count", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1 } }], "responses": { "200": { "$ref": "#/components/responses/Collection" }, "422": { "$ref": "#/components/responses/Error" } } } },
    "/v1/booking/bookings": {
      "get": { "tags": ["Bookings"], "summary": "List bookings", "x-operix-scope": "booking:read", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Status" }, { "$ref": "#/components/parameters/ExternalReference" }, { "$ref": "#/components/parameters/ServiceId" }, { "$ref": "#/components/parameters/ProviderId" }, { "$ref": "#/components/parameters/CreatedAfter" }, { "$ref": "#/components/parameters/CreatedBefore" }], "responses": { "200": { "$ref": "#/components/responses/Collection" } } },
      "post": { "tags": ["Bookings"], "summary": "Create a booking", "description": "The complete availability and conflict engine runs inside the final transaction; a prior availability request is only advisory.", "x-operix-scope": "booking:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Booking" }, "responses": { "201": { "$ref": "#/components/responses/Booking" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/booking/bookings/{id}": { "get": { "tags": ["Bookings"], "summary": "Get a booking", "x-operix-scope": "booking:read", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Booking" } } }, "patch": { "tags": ["Bookings"], "summary": "Update a booking", "x-operix-scope": "booking:write", "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Booking" }, "responses": { "200": { "$ref": "#/components/responses/Booking" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/booking/bookings/{id}/confirm": { "post": { "tags": ["Bookings"], "summary": "Confirm a booking", "x-operix-scope": "booking:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Booking" } } } },
    "/v1/booking/bookings/{id}/reschedule": { "post": { "tags": ["Bookings"], "summary": "Reschedule a booking", "x-operix-scope": "booking:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reschedule" }, "responses": { "200": { "$ref": "#/components/responses/Booking" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/v1/booking/bookings/{id}/cancel": { "post": { "tags": ["Bookings"], "summary": "Cancel a booking", "x-operix-scope": "booking:cancel", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Reason" }, "responses": { "200": { "$ref": "#/components/responses/Booking" } } } },
    "/v1/booking/bookings/{id}/check-in": { "post": { "tags": ["Bookings"], "summary": "Check in a booking", "x-operix-scope": "booking:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Booking" } } } },
    "/v1/booking/bookings/{id}/complete": { "post": { "tags": ["Bookings"], "summary": "Complete a booking", "x-operix-scope": "booking:write", "x-operix-idempotent": true, "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Booking" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "OperiX API key", "description": "Use a Test key (opx_test_...) or Live key (opx_live_...). Never put a secret key in browser code." } },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string" } },
      "Search": { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 160 } },
      "Status": { "name": "status", "in": "query", "schema": { "type": "string" } },
      "DocumentType": { "name": "document_type", "in": "query", "schema": { "type": "string", "enum": ["INVOICE", "QUOTE", "PROFORMA", "SALES_ORDER", "DELIVERY_NOTE", "ADVANCE_INVOICE", "FINAL_INVOICE", "CREDIT_NOTE", "DEBIT_NOTE", "SIMPLIFIED_INVOICE", "FISCAL_RECEIPT", "BAD_DEBT_INVOICE"] } },
      "ExternalReference": { "name": "external_reference", "in": "query", "schema": { "type": "string", "maxLength": 160 } },
      "CustomerId": { "name": "customer_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
      "ServiceId": { "name": "service_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
      "ProviderId": { "name": "provider_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
      "CreatedAfter": { "name": "created_after", "in": "query", "schema": { "type": "string", "format": "date-time" } },
      "CreatedBefore": { "name": "created_before", "in": "query", "schema": { "type": "string", "format": "date-time" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 255 }, "description": "Required for financial and booking mutations. Reusing a key with a different request returns an error." }
    },
    "requestBodies": {
      "Customer": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerInput" }, "example": { "name": "John Doe", "email": "john@example.com", "external_reference": "SHOP-CUSTOMER-842" } } } },
      "Product": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductInput" } } } },
      "Invoice": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceInput" }, "example": { "customer": { "name": "John Doe", "email": "john@example.com" }, "items": [{ "name": "Product A", "quantity": 2, "unit_price": "20.00", "vat_rate": "18" }], "currency": "EUR", "external_reference": "ORDER-58391" } } } },
      "Payment": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentInput" } } } },
      "Service": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServiceInput" } } } },
      "Provider": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProviderInput" } } } },
      "Location": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocationInput" } } } },
      "Resource": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceInput" } } } },
      "Booking": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookingInput" }, "example": { "service_id": "00000000-0000-4000-8000-000000000123", "starts_at": "2026-08-28T14:00:00+02:00", "customer": { "name": "John Doe", "email": "john@example.com" }, "external_reference": "WEBSITE-BOOKING-8392" } } } },
      "Reschedule": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["starts_at"], "properties": { "starts_at": { "type": "string", "format": "date-time" }, "ends_at": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "maxLength": 500 } }, "additionalProperties": false } } } },
      "Reason": { "content": { "application/json": { "schema": { "type": "object", "properties": { "reason": { "type": "string", "maxLength": 500 } }, "additionalProperties": false } } } }
    },
    "responses": {
      "Collection": { "description": "Collection", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Collection" } } } },
      "Customer": { "description": "Customer", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Product": { "description": "Product", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Invoice": { "description": "Invoice", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Payment": { "description": "Payment", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Service": { "description": "Booking service", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Provider": { "description": "Booking provider", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Location": { "description": "Booking location", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Resource": { "description": "Booking resource", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Booking": { "description": "Booking", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Error": { "description": "Error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": { "code": "booking_conflict", "message": "The requested time is no longer available.", "request_id": "req_xxxxxxxx" } } } } }
    },
    "schemas": {
