# This file is copied to .env by scripts/chatwoot.sh init.
# Keep .env private. It contains the application and database secrets.

# Pin the Community Edition image. Change this intentionally when upgrading.
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.16.2-ce
CHATWOOT_PORT=3040

# Application
SECRET_KEY_BASE=__GENERATE_SECRET_KEY_BASE__
FRONTEND_URL=http://127.0.0.1:3040
FORCE_SSL=false
# Leave enabled for the first local admin account, then set to false.
ENABLE_ACCOUNT_SIGNUP=true
INSTALLATION_ENV=docker
RAILS_ENV=production
RAILS_MAX_THREADS=5

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__

# Postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__

# Local file storage
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Outbound email is intentionally unset for a local-only install.
# Configure these values before using invitations, password reset, or email inboxes.
MAILER_SENDER_EMAIL=OperiX Chatwoot <chatwoot@localhost>
SMTP_DOMAIN=localhost
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
