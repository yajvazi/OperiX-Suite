# Copy to .env on the CRM host. Do not commit the real file.
TWENTY_TAG=v2.8.5
SERVER_URL=https://crm.operixsuite.com
OPERIX_CRM_BIND_PORT=3020

PG_DATABASE_NAME=twenty
PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=replace-with-a-strong-password-without-special-characters
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-random-32-byte-value
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=

STORAGE_TYPE=local
IS_MULTIWORKSPACE_ENABLED=false
IS_CONFIG_VARIABLES_IN_DB_ENABLED=false
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false
