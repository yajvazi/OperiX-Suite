# Server/Edge Function secrets only. Never expose these through EXPO_PUBLIC_*.
DEEPSEEK_API_KEY=

# Optional provider-swappable document OCR/parser. If unset, the Edge Function
# uses the existing server-side OperiX document parser when GEMINI_API_KEY is set.
OPERIX_DOCUMENT_OCR_URL=
OPERIX_DOCUMENT_OCR_TOKEN=
GEMINI_API_KEY=

# Optional server-side reminder delivery provider. Reminder preparation works
# without it; sending remains disabled until this endpoint is configured.
OPERIX_REMINDER_EMAIL_URL=
OPERIX_REMINDER_EMAIL_TOKEN=
