NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
CHROME_EXECUTABLE_PATH=/usr/bin/chromium
NEXT_PUBLIC_INVOICE_APP_URL=https://invoice.example.com
NEXT_PUBLIC_OPERIX_HELP_CENTER_URL=
NEXT_PUBLIC_OPERIX_INVOICE_DEEP_LINK=
NEXT_PUBLIC_OPERIX_INVOICE_APP_SCHEME=operix-invoice
NEXT_PUBLIC_OPERIX_INVOICE_IOS_URL=
NEXT_PUBLIC_OPERIX_INVOICE_ANDROID_URL=
OPERIX_INVOICE_ANDROID_SHA256_CERT_FINGERPRINT=
OPERIX_INVOICE_ANDROID_PACKAGE=

# OperiX product subscriptions. Keep all Stripe values server-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-07-29.dahlia
STRIPE_INVOICE_MONTHLY_PRICE_ID=
STRIPE_INVOICE_ANNUAL_PRICE_ID=
STRIPE_BOOKING_MONTHLY_PRICE_ID=
STRIPE_BOOKING_ANNUAL_PRICE_ID=
STRIPE_SUITE_MONTHLY_PRICE_ID=
STRIPE_SUITE_ANNUAL_PRICE_ID=
STRIPE_API_ADDON_MONTHLY_PRICE_ID=
STRIPE_TENANT_MONTHLY_PRICE_ID=
STRIPE_TENANT_ANNUAL_PRICE_ID=
STRIPE_USER_MONTHLY_PRICE_ID=
STRIPE_USER_ANNUAL_PRICE_ID=
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_ALLOW_PROMOTION_CODES=false
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=
STRIPE_PAST_DUE_GRACE_DAYS=7
BILLING_APP_URL=https://invoice.example.com
CRON_SECRET=

# Public API server-side integration. Test traffic must use a separate
# Supabase project; these values are never sent to the browser.
PUBLIC_API_PDF_SIGNING_SECRET=
PUBLIC_API_WEBHOOK_ENCRYPTION_KEY=
INTERNAL_JOB_SECRET=
PUBLIC_API_TEST_SUPABASE_URL=
PUBLIC_API_TEST_SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_API_TEST_SUPABASE_JWT_SECRET=

# OperiX CRM integration. Keep all non-NEXT_PUBLIC values server-side.
OPERIX_TWENTY_API_URL=https://crm.operixsuite.com
OPERIX_TWENTY_API_KEY=
OPERIX_TWENTY_INVOICE_CUSTOMER_FIELD=operixInvoiceCustomerId
OPERIX_TWENTY_WEBHOOK_SECRET=
OPERIX_INTERNAL_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPERIX_CRM_ENABLED=false
OPERIX_CRM_SYNC_CUSTOMERS=false
OPERIX_CRM_CREATE_DRAFT_ON_WON=false
OPERIX_CRM_DEEP_LINKS_ENABLED=false
OPERIX_CRM_WEBHOOKS_ENABLED=false

# Optional server-side contract signing provider.
DOCUMENSO_API_URL=
DOCUMENSO_API_KEY=

# Self-hosting: hides the hosted billing screens, and names this server in the mobile app's
# "Connect to your own server" screen. Needs a rebuild after changing.
NEXT_PUBLIC_SELF_HOSTED=false
NEXT_PUBLIC_SERVER_NAME=

# POS is hidden by default. Consumer sales in Kosovo must be registered through an
# ATK-certified fiscal software (SEF); this build does not issue fiscal receipts.
# Set to true only for non-fiscal use or when a certified fiscal module is installed.
NEXT_PUBLIC_POS_ENABLED=false
# NEXT_PUBLIC_POS_NOTICE=

# Optional: serve the public demo from its own hostname (rewrites to /demo).
# DEMO_HOSTNAME=demo.invoice.example.com
# Optional: iOS universal links for a mobile app you operate.
# OPERIX_INVOICE_IOS_TEAM_ID=
# OPERIX_INVOICE_IOS_BUNDLE_ID=
