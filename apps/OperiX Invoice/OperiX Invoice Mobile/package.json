{
  "name": "operix-invoice",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --tunnel --clear",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel --clear",
    "start:localhost": "expo start --localhost",
    "android": "expo start --android --lan",
    "ios": "expo start --ios --lan",
    "web": "expo start --web",
    "dev": "expo start --tunnel --clear",
    "lint": "eslint src test --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:ci",
    "test:legacy": "node --test src/navigation/navigation.test.mjs src/services/contracts/contractBuilder.test.mjs",
    "test:unit": "jest --config jest.config.cjs --runInBand test/unit",
    "test:component": "jest --config jest.config.cjs --runInBand test/component",
    "test:ui": "jest --config jest.config.cjs --runInBand test/component test/ui",
    "test:integration": "jest --config jest.config.cjs --runInBand test/integration",
    "test:core": "node --import tsx --test ../../../packages/money/src/index.test.ts ../../../packages/api/src/domain.test.ts ../../../packages/api/src/workspace.test.ts",
    "test:core:coverage": "node --import tsx --test --experimental-test-coverage ../../../packages/money/src/index.test.ts ../../../packages/api/src/domain.test.ts ../../../packages/api/src/workspace.test.ts",
    "test:coverage": "jest --config jest.config.cjs --runInBand --coverage && npm run test:core:coverage",
    "test:ci": "npm run lint && npm run typecheck && npm run localization:check && npm run test:legacy && npm run test:core && npm run test:unit && npm run test:ui && npm run test:integration",
    "test:mobile": "npm run typecheck && npm run localization:check && npm run build:check",
    "test:e2e": "node test/e2e/run-maestro.mjs",
    "test:visual": "node test/visual/run-maestro-visual.mjs",
    "test:visual:update": "node test/visual/run-maestro-visual.mjs --update",
    "test:mobile-ui": "npm run lint && npm run typecheck && npm run test:ui",
    "audit:mobile-test": "node ../../../scripts/audit-mobile-testing.mjs",
    "build:check": "expo export --platform web --output-dir /tmp/operix-invoice-mobile-web",
    "localization:check": "node ../../../scripts/check-mobile-localization.mjs",
    "eas-build-post-install": "node scripts/patch-expo-constants-path.js"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@invoice-monorepo/api": "*",
    "@invoice-monorepo/billing": "*",
    "@invoice-monorepo/commercial-documents": "*",
    "@invoice-monorepo/context": "*",
    "@invoice-monorepo/hooks": "*",
    "@invoice-monorepo/i18n": "*",
    "@invoice-monorepo/invoice-template": "*",
    "@invoice-monorepo/report-templates": "*",
    "@invoice-monorepo/types": "*",
    "@invoice-monorepo/ui": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@supabase/supabase-js": "^2.89.0",
    "babel-preset-expo": "~57.0.11",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-auth-session": "~58.0.14",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-local-authentication": "~58.0.2",
    "expo-mail-composer": "~58.0.3",
    "expo-notifications": "~58.1.6",
    "expo-print": "~58.0.7",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.88.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
