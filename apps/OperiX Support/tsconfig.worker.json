{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "plugins": []
  },
  "include": ["src/worker/**/*.ts", "src/lib/**/*.ts", "src/types/**/*.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
