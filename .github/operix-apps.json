{
  "schemaVersion": 1,
  "repository": "yajvazi/OperiX-Suite",
  "defaultBranch": "main",
  "sharedPathRules": [
    { "pattern": "package.json", "apps": "all" },
    { "pattern": "package-lock.json", "apps": "all" },
    { "pattern": "turbo.json", "apps": "all" },
    { "pattern": "tsconfig.base.json", "apps": "all" },
    { "pattern": "packages/**", "apps": "all" },
    { "pattern": "supabase/**", "apps": "all" },
    { "pattern": "qa/mobile/**", "apps": "mobile" },
    { "pattern": "scripts/operix-mobile-qa.mjs", "apps": "mobile" },
    { "pattern": "scripts/cicd/**", "apps": "all" },
    { "pattern": ".github/**", "apps": "all" },
    { "pattern": "docs/**", "apps": [] }
  ],
  "apps": [
    {
      "id": "operix-suite-marketing",
      "name": "OperiX Suite Marketing",
      "type": "WEB",
      "sourceStatus": "origin-main",
      "path": "apps/OperiX Suite",
      "workspace": "operix-suite-marketing",
      "runner": "npm",
      "framework": "Next.js",
      "runtime": "Node.js 22",
      "backend": "Public Next.js app with optional CRM link",
      "commands": { "lint": "lint", "typecheck": "typecheck", "test": null, "build": "build" },
      "healthPath": "/api/health",
      "publicUrl": "https://operixsuite.com",
      "dockerfile": "apps/OperiX Suite/Dockerfile",
      "artifactRepository": "ghcr.io/yajvazi/operix-suite-marketing",
      "deployment": { "kind": "docker", "container": "operix-operix-suite-1", "composeService": "operix-suite", "composeFile": "docker-compose.suite.yml", "port": 3013 }
    },
    {
      "id": "operix-invoice-web",
      "name": "OperiX Invoice Web",
      "type": "WEB",
      "sourceStatus": "origin-main",
      "path": "apps/OperiX Invoice/OperiX Web",
      "workspace": "web-suite",
      "runner": "npm",
      "framework": "Next.js",
      "runtime": "Node.js 22",
      "backend": "Supabase/PostgreSQL plus Next.js API routes",
      "commands": { "lint": "lint", "typecheck": "typecheck", "test": "test", "build": "build" },
      "healthPath": "/api/health",
      "publicUrl": "https://invoice.operixsuite.com",
      "dockerfile": "apps/OperiX Invoice/OperiX Web/Dockerfile",
      "artifactRepository": "ghcr.io/yajvazi/operix-invoice-web",
      "deployment": { "kind": "docker", "container": "operix-operix-web-1", "composeService": "operix-web", "composeFile": "docker-compose.web.yml", "port": 3006 }
    },
    {
      "id": "operix-invoice-mobile",
      "name": "OperiX Invoice Mobile",
      "type": "MOBILE",
      "sourceStatus": "origin-main",
      "path": "apps/OperiX Invoice/OperiX Invoice Mobile",
      "workspace": "operix-invoice",
      "runner": "npm",
      "framework": "Expo / React Native",
      "runtime": "Node.js 20, Expo/EAS",
      "backend": "Supabase/PostgreSQL",
      "commands": { "lint": "lint", "typecheck": "typecheck", "test": "test:ci", "build": "build:check" },
      "expoConfig": "apps/OperiX Invoice/OperiX Invoice Mobile/app.json",
      "easConfig": "apps/OperiX Invoice/OperiX Invoice Mobile/eas.json",
      "deployment": { "kind": "eas", "qaProfile": "preview", "releaseProfile": "production" }
    },
    {
      "id": "operix-booking-web",
      "name": "OperiX Booking Web",
      "type": "WEB",
      "sourceStatus": "worktree-only",
      "path": "apps/OperiX Booking/OperiX Booking Web",
      "workspace": "operix-booking-web",
      "runner": "npm",
      "framework": "Next.js",
      "runtime": "Node.js 20/22",
      "backend": "Supabase/PostgreSQL",
      "commands": { "lint": "lint", "typecheck": "typecheck", "test": "test", "build": "build" },
      "healthPath": "/api/health",
      "publicUrl": "https://booking.operixsuite.com",
      "deployment": { "kind": "pm2", "process": "operix-booking-web", "port": 3015 }
    },
    {
      "id": "operix-booking-mobile",
      "name": "OperiX Booking Mobile",
      "type": "MOBILE",
      "sourceStatus": "worktree-only",
      "path": "apps/OperiX Booking/OperiX Booking Mobile",
      "workspace": "operix-booking-mobile",
      "runner": "npm",
      "framework": "Expo / React Native",
      "runtime": "Node.js 20, Expo/EAS",
      "backend": "Supabase/PostgreSQL",
      "commands": { "lint": null, "typecheck": "typecheck", "test": null, "build": "build:check" },
      "expoConfig": "apps/OperiX Booking/OperiX Booking Mobile/app.json",
      "easConfig": "apps/OperiX Booking/OperiX Booking Mobile/eas.json",
      "deployment": { "kind": "eas", "qaProfile": "preview", "releaseProfile": "production" }
    },
    {
      "id": "operix-desk-web",
      "name": "OperiX Desk Web",
      "type": "WEB",
      "sourceStatus": "origin-main",
      "path": "apps/OperiX Desk/frontend",
      "workspace": "frontend",
      "runner": "npm",
      "framework": "Vite / React",
      "runtime": "Node.js 22",
      "backend": "FastAPI Desk API and Supabase/PostgreSQL",
      "commands": { "lint": "lint", "typecheck": null, "test": null, "build": "build" },
      "healthPath": "/api/health",
      "publicUrl": "https://desk.operixsuite.com",
      "dockerfile": "apps/OperiX Desk/frontend/Dockerfile",
      "artifactRepository": "ghcr.io/yajvazi/operix-desk-web",
      "deployment": { "kind": "docker", "container": "operixdesk-frontend-1", "composeService": "frontend", "composeFile": "apps/OperiX Desk/docker-compose.yml", "port": 3007 }
    },
    {
      "id": "operix-desk-api",
      "name": "OperiX Desk API",
      "type": "BACKEND",
      "sourceStatus": "origin-main",
      "path": "apps/OperiX Desk/backend",
      "runner": "python",
      "framework": "FastAPI / SQLAlchemy",
      "runtime": "Python 3.13",
      "backend": "Supabase/PostgreSQL",
      "commands": { "compile": ["-m", "compileall", "-q", "app"] },
      "healthPath": "/api/health",
      "publicUrl": "https://desk.operixsuite.com",
      "dockerfile": "apps/OperiX Desk/backend/Dockerfile",
      "buildContext": "apps/OperiX Desk/backend",
      "artifactRepository": "ghcr.io/yajvazi/operix-desk-api",
      "deployment": { "kind": "docker", "container": "operixdesk-backend-1", "composeService": "backend", "composeFile": "apps/OperiX Desk/docker-compose.yml", "port": 8002 }
    },
    {
      "id": "operix-desk-mobile",
      "name": "OperiX Desk Mobile",
      "type": "MOBILE",
      "sourceStatus": "worktree-only",
      "path": "apps/OperiX Desk/OperiX Desk Mobile",
      "workspace": "operix-desk-mobile",
      "runner": "npm",
      "framework": "Expo / React Native",
      "runtime": "Node.js 20, Expo/EAS",
      "backend": "Desk API and Supabase/PostgreSQL",
      "commands": { "lint": null, "typecheck": "typecheck", "test": null, "build": "build:check" },
      "expoConfig": "apps/OperiX Desk/OperiX Desk Mobile/app.json",
      "easConfig": "apps/OperiX Desk/OperiX Desk Mobile/eas.json",
      "deployment": { "kind": "eas", "qaProfile": "preview", "releaseProfile": "production" }
    },
    {
      "id": "operix-hr-web",
      "name": "OperiX HR Web",
      "type": "WEB",
      "sourceStatus": "worktree-only",
      "path": "apps/operix-hr-web",
      "workspace": "operix-hr-web",
      "runner": "npm",
      "framework": "Next.js",
      "runtime": "Node.js 20/22",
      "backend": "Supabase/PostgreSQL",
      "commands": { "lint": "lint", "typecheck": "typecheck", "test": null, "build": "build" },
      "healthPath": "/api/health",
      "publicUrl": "https://hr.operixsuite.com",
      "deployment": { "kind": "pm2", "process": "operix-hr-web", "port": 3014 }
    },
    {
      "id": "operix-hr-mobile",
      "name": "OperiX HR Mobile",
      "type": "MOBILE",
      "sourceStatus": "origin-main",
      "path": "apps/hr-app",
      "workspace": "operix-hr",
      "runner": "npm",
      "framework": "Expo / React Native",
      "runtime": "Node.js 20, Expo/EAS",
      "backend": "Supabase/PostgreSQL",
      "commands": { "lint": null, "typecheck": "typecheck", "test": null, "build": "build:check" },
      "expoConfig": "apps/hr-app/app.json",
      "easConfig": "apps/hr-app/eas.json",
      "deployment": { "kind": "eas", "qaProfile": "preview", "releaseProfile": "production" }
    },
    {
      "id": "operix-control",
      "name": "OperiX Control",
      "type": "WEB",
      "sourceStatus": "worktree-only",
      "path": "apps/operix-control",
      "workspace": "operix-control",
      "runner": "npm",
      "framework": "Next.js",
      "runtime": "Node.js 20/22",
      "backend": "Supabase/PostgreSQL and product health probes",
      "commands": { "lint": "lint", "typecheck": "typecheck", "test": "test", "build": "build" },
      "healthPath": "/api/health",
      "publicUrl": "https://control.operixsuite.com",
      "deployment": { "kind": "pm2", "process": "operix-control", "port": 3016 }
    },
    {
      "id": "operix-help-center",
      "name": "OperiX Help Center",
      "type": "STATIC_SITE",
      "sourceStatus": "worktree-only",
      "path": "apps/OperiX Help Center",
      "workspace": "operix-help-center",
      "runner": "npm",
      "framework": "Next.js content site",
      "runtime": "Node.js 22",
      "backend": "Content routes plus health API",
      "commands": { "lint": "lint", "typecheck": "typecheck", "test": "test", "build": "build" },
      "healthPath": "/api/health",
      "publicUrl": "https://helpdesk.operixsuite.com",
      "dockerfile": "apps/OperiX Help Center/Dockerfile",
      "artifactRepository": "ghcr.io/yajvazi/operix-help-center",
      "deployment": { "kind": "docker", "container": "operix-help-center", "composeService": "operix-help-center", "composeFile": "docker-compose.help-center.yml", "port": 3042 }
    },
    {
      "id": "operix-scanner",
      "name": "OperiX Scanner",
      "type": "MOBILE",
      "sourceStatus": "origin-main",
      "path": "apps/OperiX Scanner",
      "workspace": "operix-scanner",
      "runner": "npm",
      "framework": "Expo / React Native",
      "runtime": "Node.js 20, Expo/EAS",
      "backend": "Supabase/PostgreSQL",
      "commands": { "lint": null, "typecheck": "typecheck", "test": null, "build": "build:check" },
      "expoConfig": "apps/OperiX Scanner/app.json",
      "easConfig": "apps/OperiX Scanner/eas.json",
      "deployment": { "kind": "eas", "qaProfile": "preview", "releaseProfile": "production" }
    },
    {
      "id": "operix-tracker",
      "name": "OperiX Tracker",
      "type": "MOBILE",
      "sourceStatus": "origin-main",
      "path": "apps/OperiX Tracker",
      "workspace": "operix-tracker",
      "runner": "npm",
      "framework": "Expo / React Native",
      "runtime": "Node.js 20, Expo/EAS",
      "backend": "Supabase/PostgreSQL",
      "commands": { "lint": null, "typecheck": "typecheck", "test": null, "build": "build:check" },
      "expoConfig": "apps/OperiX Tracker/app.json",
      "easConfig": "apps/OperiX Tracker/eas.json",
      "deployment": { "kind": "eas", "qaProfile": "preview", "releaseProfile": "production" }
    }
  ]
